# ============================================================
# API 配置模板
# ============================================================
# 用法：把本文件复制成 .env（去掉 .example），然后填入你的 key。
#
#   PowerShell:  Copy-Item .env.example .env
#   然后编辑 .env
#
# .env 已被 .gitignore 排除，不会被提交。绝对不要把 key 写进代码里。
# ------------------------------------------------------------

# ---------- 方案 A：OpenAI 官方 ----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
EMB_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ---------- 方案 B：DeepSeek（最便宜，但没有 embedding 接口）----------
# 注意：DeepSeek 只提供 chat，不提供 embeddings。
# 若用 DeepSeek，需要把 embedding 换成别家，或用 USE_HASH_EMBED=1。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# EMB_MODEL=text-embedding-3-small

# ---------- 方案 C：阿里云百炼（通义，chat + embedding 都有）----------
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=
# LLM_MODEL=qwen-plus
# EMB_MODEL=text-embedding-v3

# ---------- 方案 D：智谱 GLM ----------
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=
# LLM_MODEL=glm-4-flash
# EMB_MODEL=embedding-3

# ---------- 方案 E：本地/代理的 OpenAI 兼容服务 ----------
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen2.5-7B-Instruct
# EMB_MODEL=bge-m3

# ---------- 完全离线（不花钱，用于先跑通流程）----------
# 打开下面这行后，ingest 会用 hash embedding，eval 只跑检索层：
# USE_HASH_EMBED=1
